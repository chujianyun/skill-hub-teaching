:80 {
  encode gzip
  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    -Server
  }
  handle /api/* {
    request_body {
      max_size 26MB
    }
    reverse_proxy server:3000
  }
  handle /assets/* {
    root * /srv
    @exists file
    header @exists Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  handle {
    root * /srv
    header Cache-Control no-cache
    try_files {path} /index.html
    file_server
  }
}
