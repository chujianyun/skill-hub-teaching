{
  "name": "skill-hub-teaching",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:db": "node scripts/dev-db.mjs",
    "test:e2e:api": "pnpm --filter @skill-hub/server test:e2e",
    "test:e2e:web": "pnpm --filter @skill-hub/web test:e2e",
    "test": "pnpm test:e2e:api && pnpm test:e2e:web",
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs"
  }
}
